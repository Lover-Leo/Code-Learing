# C/C++ build products
*.exe
*.obj
*.o
*.pdb
*.ilk
*.lib
*.dll

# Build directories
build/
out/
.vs/

# Editor settings that are machine-specific
.vscode/*.log

# Temporary files
*.tmp
*.bak
*~

# macOS / Clang debug products
*.dSYM/
*.a
*.so
*.dylib
.DS_Store

# Executables from the current single-file C++ exercises
/cpp_practice/**/main
/LeetCode-Hot100/**/main
/Book Manager/bookManager

# Local runtime logs
*.log

# Local editor configuration (keep shared scripts)
/.vscode/*.json
!/.vscode/tasks.json
!/.vscode/launch.json
!/.vscode/settings.json
!/.vscode/c_cpp_properties.json
!/.vscode/extensions.json

# Python environments and generated files
.venv/
venv/
__pycache__/
*.py[cod]

# Executables generated by Luogu C++ exercises
/luogu/**/main
